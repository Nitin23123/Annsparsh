# Server Environment Variables
PORT=5000
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# Optional: Frontend Client URL for CORS (comma-separated for multiple domains)
# Example: https://annsparsh.vercel.app,https://my-domain.com
CLIENT_URL=http://localhost:5173

# Database Option A: Single Connection String (Neon, Supabase, Render, Railway, etc.)
# DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require

# Database Option B: Discrete Parameters (Local Postgres or Managed)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=annsparsh
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false
